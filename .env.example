# Discord Bot Configuration
DiscordVoiceDatabase_TOKEN=your_discord_bot_token_here
DiscordVoiceDatabase_PREFIX=!
DiscordVoiceDatabase_INVITE_LINK=your_invite_link_here
DiscordVoiceDatabase_VERSION=1.0.0

# Access Control
# If set, only members with this role ID can use bot commands. Leave unset to allow everyone.
# DiscordVoiceDatabase_ROLE_ID=123456789012345678

# Recording Configuration
# These have sensible defaults — only override if needed
# DiscordVoiceDatabase_DB_PATH=./data/database.db
# DiscordVoiceDatabase_RECORDINGS_PATH=./recordings
# DiscordVoiceDatabase_CLIPS_PATH=./clips
# DiscordVoiceDatabase_RETENTION_DAYS=7
